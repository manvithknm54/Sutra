// ==========================================
// SUTRA - College ERP Database Schema
// Prisma ORM 6.19.3
// PostgreSQL - Neon
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  FACULTY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum MarksStatus {
  DRAFT
  SUBMITTED
  MODERATED
  LOCKED
}

enum LedgerType {
  CHARGE
  PAYMENT
  SCHOLARSHIP
}

enum FlagStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// ==========================================
// CAMPUS
// ==========================================

model Campus {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique

  users      User[]
  students   Student[]
  programmes Programme[]
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String   @id @default(cuid())
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id])

  name         String
  email        String   @unique
  passwordHash String
  role         Role

  createdAt    DateTime @default(now())

  allocations  CourseAllocation[]
  sessions     AttendanceSession[]
  tasks        MentorTask[]
}

// ==========================================
// PROGRAMMES
// ==========================================

model Programme {
  id            String   @id @default(cuid())
  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id])

  code          String
  name          String
  years         Int

  batches       Batch[]
  subjects      Subject[]
  feeStructures FeeStructure[]

  @@unique([campusId, code])
}

// ==========================================
// BATCHES
// ==========================================

model Batch {
  id          String   @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  startYear   Int
  label       String

  students    Student[]
  allocations CourseAllocation[]

  @@unique([programmeId, startYear])
}

// ==========================================
// SUBJECTS
// ==========================================

model Subject {
  id          String   @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  code        String
  name        String
  semester    Int

  allocations CourseAllocation[]

  @@unique([programmeId, code])
}

// ==========================================
// COURSE ALLOCATIONS
// ==========================================

model CourseAllocation {
  id          String   @id @default(cuid())

  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])

  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])

  facultyId   String
  faculty     User     @relation(fields: [facultyId], references: [id])

  marksStatus MarksStatus @default(DRAFT)
  lockedAt    DateTime?

  sessions    AttendanceSession[]
  components  MarkComponent[]

  @@unique([subjectId, batchId])
}

// ==========================================
// STUDENTS
// ==========================================

model Student {
  id              String   @id @default(cuid())

  campusId        String
  campus          Campus   @relation(fields: [campusId], references: [id])

  batchId         String
  batch           Batch    @relation(fields: [batchId], references: [id])

  rollNo          String   @unique
  name            String
  category        String   @default("GENERAL")

  guardianPhone   String?
  isMinor         Boolean  @default(false)
  guardianConsent Boolean  @default(false)

  attendance      AttendanceRecord[]
  marks           MarkEntry[]
  ledger          FeeLedgerEntry[]
  flags           RiskFlag[]
  alerts          AlertLog[]
}

// ==========================================
// ATTENDANCE SESSIONS
// ==========================================

model AttendanceSession {
  // UUID generated by the client device.
  id           String   @id

  allocationId String
  allocation   CourseAllocation @relation(fields: [allocationId], references: [id])

  date         DateTime @db.Date
  period       Int

  markedById   String
  markedBy     User     @relation(fields: [markedById], references: [id])

  deviceTime   DateTime
  serverTime   DateTime @default(now())
  version      Int      @default(1)

  records      AttendanceRecord[]

  @@unique([allocationId, date, period])
}

// ==========================================
// ATTENDANCE RECORDS
// ==========================================

model AttendanceRecord {
  id        String @id @default(cuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status    AttendanceStatus

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ==========================================
// MARK COMPONENTS
// ==========================================

model MarkComponent {
  id           String @id @default(cuid())

  allocationId String
  allocation   CourseAllocation @relation(fields: [allocationId], references: [id])

  name         String
  maxMarks     Int

  entries      MarkEntry[]

  @@unique([allocationId, name])
}

// ==========================================
// MARK ENTRIES
// ==========================================

model MarkEntry {
  id               String @id @default(cuid())

  componentId      String
  component        MarkComponent @relation(fields: [componentId], references: [id])

  studentId        String
  student          Student @relation(fields: [studentId], references: [id])

  rawMarks         Decimal @db.Decimal(5, 2)
  moderationDelta  Decimal @default(0) @db.Decimal(5, 2)
  moderationReason String?

  @@unique([componentId, studentId])
}

// ==========================================
// MARK AUDIT
// Append-only audit history
// ==========================================

model MarkAudit {
  id           String   @id @default(cuid())

  entryId      String?
  allocationId String
  actorId      String

  action       String
  oldValue     String?
  newValue     String?
  reason       String?

  at           DateTime @default(now())

  @@index([allocationId])
}

// ==========================================
// FEE STRUCTURES
// ==========================================

model FeeStructure {
  id          String @id @default(cuid())

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  category    String
  yearNo      Int
  amountPaise Int

  @@unique([programmeId, category, yearNo])
}

// ==========================================
// FEE LEDGER
// Append-only financial transactions
// ==========================================

model FeeLedgerEntry {
  id             String   @id @default(cuid())

  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])

  type           LedgerType
  amountPaise    Int
  note           String?

  idempotencyKey String   @unique

  at             DateTime @default(now())

  @@index([studentId])
}

// ==========================================
// STUDENT RISK FLAGS
// ==========================================

model RiskFlag {
  id            String   @id @default(cuid())

  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])

  score         Int
  reasons       Json

  status        FlagStatus @default(OPEN)
  dismissReason String?

  createdAt     DateTime @default(now())

  task          MentorTask?
}

// ==========================================
// MENTOR TASKS
// ==========================================

model MentorTask {
  id        String   @id @default(cuid())

  flagId    String   @unique
  flag      RiskFlag @relation(fields: [flagId], references: [id])

  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id])

  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// ALERT LOGS
// ==========================================

model AlertLog {
  id        String   @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  kind      String
  weekKey   String

  channel   String   @default("MOCK_SMS")
  language  String   @default("EN")
  body      String

  at        DateTime @default(now())

  @@unique([studentId, kind, weekKey])
}